  "cards": [
    {
      "dot": "cyan",
      "title": "Cảm biến & Hiệu năng Client",
      "items": [
        "Pedometer chỉ ghi vào useRef, tách biệt hoàn toàn với chu kỳ render UI 1000ms",
        "Tính nhịp bước (Cadence) bằng cửa sổ trượt 30s trên mảng vòng cố định 32 phần tử",
        "Bản đồ Leaflet WebView tự động lưu cache tile ngoại tuyến vào IndexedDB (150MB)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lưu trữ & Đồng bộ Offline-First",
      "items": [
        "Tự động lưu Checkpoint (<2KB) mỗi 15 giây hoặc mỗi 50 bước vào AsyncStorage",
        "Khi dừng chạy: đưa ngay vào hàng đợi cục bộ trước khi gọi API với Backoff (2s, 5s, 15s)",
        "Khi gặp lỗi 401 (hết hạn token): bảo toàn hàng đợi, chờ đăng nhập lại để đồng bộ tiếp"
      ]
    },
    {
      "dot": "rose",
      "title": "Bảo mật & Toàn vẹn Dữ liệu Server",
      "items": [
        "Token ký bằng HMAC-SHA256 (TTL 7 ngày), lưu độc quyền trong Expo SecureStore",
        "Phân quyền RBAC tách biệt bảng dùng chung (goals, exercises) và bảng cá nhân (userId)",
        "Chống ghi trùng (Idempotent) theo clientId và kiểm tra chéo công thức quãng đường (HTTP 422)"
      ]
    }
  ]
