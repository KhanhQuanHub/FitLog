  "cards": [
    {
      "dot": "cyan",
      "title": "Khóa & Quy tắc sở hữu (RBAC)",
      "items": [
        "users là bảng trung tâm: 5 bảng cá nhân (profiles, weightHistory, runs, userGoals, workouts) đều gắn khóa ngoại userId.",
        "Middleware auth.js tự động ép userId theo chủ sở hữu token khi truy vấn hoặc ghi trên 5 bảng OWNED.",
        "2 bảng danh mục (goals, exercises) thuộc nhóm PUBLIC_READ: mọi người dùng đều đọc được, chỉ admin được phép ghi."
      ]
    },
    {
      "dot": "emerald",
      "title": "Ràng buộc toàn vẹn bảng runs (HTTP 422)",
      "items": [
        "Khóa clientId (r_<timestamp>_<rand>) kết hợp userId giúp chống ghi trùng (Idempotent) khi mạng chập chờn retry.",
        "Kiểm tra miền giá trị: steps [0..100000], durationSec [10..21600], avgSpeedKmh [0..25], calories [0..3000].",
        "Kiểm tra công thức vật lý: |distanceKm - steps * strideM / 1000| <= 0.05."
      ]
    },
    {
      "dot": "amber",
      "title": "Cây quyết định Y tế & Công thức Calo",
      "items": [
        "profiles.healthCondition lọc exercises: bệnh khớp (joint) chỉ lấy impact = low; bệnh tim mạch (cardio) giới hạn met <= 5.0.",
        "workouts.caloriesBurned tính theo met * weightKg * (durationMin / 60).",
        "weightHistory chỉ thêm dòng mới (append-only) mỗi lần cập nhật cân nặng để vẽ biểu đồ xu hướng."
      ]
    }
  ]
