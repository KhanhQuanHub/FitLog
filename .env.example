# ============================================================================
# Cấu hình biến môi trường mẫu cho FitLog (.env.example)
# Sao chép file này thành `.env` khi kéo dự án về máy.
# ============================================================================

# 1. Địa chỉ máy chủ json-server:
# Giữ dấu `#` bên dưới khi test bằng Expo Go cùng mạng Wi-Fi (app tự lấy IP máy chạy `npx expo start`).
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# 2. Khóa API bản đồ MapTiler
EXPO_PUBLIC_MAP_API_KEY=YOUR_MAP_API_KEY_HERE
