# ============================================================================
# Cấu hình biến môi trường mẫu cho FitLog (.env.example)
# Sao chép file này thành `.env` rồi thay IP_LAPTOP bằng địa chỉ IPv4 của laptop:
#   Windows PowerShell: ipconfig  -> tìm "Wireless LAN adapter Wi-Fi" -> "IPv4 Address"
# ============================================================================

# 1. Địa chỉ máy chủ json-server chạy trên laptop (KHÔNG dùng localhost hay 127.0.0.1)
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# 2. Khóa API bản đồ MapTiler (thay bằng khóa của bạn nếu cần, không đặt khóa thật ở file mẫu)
EXPO_PUBLIC_MAP_API_KEY=YOUR_MAP_API_KEY_HERE
